# Cloudflare Workers Static Assets 自定义响应头
#
# 注意：_headers 的规则【不会】作用于 Worker 代码生成的响应。
# 本站 HTML 由 src/worker.js 处理并自行下发 CSP（见该文件 SECURITY_HEADERS），
# 本文件负责的是由 assets 直接下发的静态资源（app.js / favicon.svg 等），
# 作为纵深防御补齐同样的安全头。
#
# 格式要点：路径行顶格、头部行缩进、注释用 #（不支持 /* */）

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; script-src-elem 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), hid=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
